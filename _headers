/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# ── PERFORMANCE: Cache-Control ──────────────────────────────────────────────
# The service worker MUST never be cached — if it's stale the app gets stuck
# on an old version. Cloudflare edge must always serve the freshest SW.
/bangle-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# The main HTML file: tell Cloudflare edge to revalidate every time,
# but allow the browser's own service-worker cache to serve it instantly.
/bangle_v19.html
  Cache-Control: no-cache
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff

/bangle_v19
  Cache-Control: no-cache
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff

# Static images and icons never change — cache at Cloudflare edge for 1 year.
# The service worker version bump forces users to re-download when anything changes.
/bangle-logo.jpg
  Cache-Control: public, max-age=31536000, immutable

/icon-192.png
  Cache-Control: public, max-age=31536000, immutable

/icon-512.png
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Cache-Control: no-cache
